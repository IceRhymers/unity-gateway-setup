# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# --- auth ---
databricks_profile = "fevm-west"

# --- foundation ---
# Reference an existing catalog (default) because this environment does not
# permit catalog creation. Flip create_catalog = true where you own catalogs.
catalog_name   = "tanner_wendland_catalog"
create_catalog = false

# --- provider catalog ---
# The opinionated default in variables.tf already defines the anthropic schema
# (4 versionless aliases + version-pinned endpoints). Override model_providers
# here to add/trim endpoints or add providers. Example (partial):
#
# model_providers = {
#   anthropic = {
#     schema_comment = "Anthropic Claude"
#     aliases = {
#       "claude-opus"   = "system.ai.databricks-claude-opus-5"
#       "claude-sonnet" = "system.ai.databricks-claude-sonnet-5"
#       "claude-haiku"  = "system.ai.databricks-claude-haiku-4-5"
#       "claude-fable"  = "system.ai.databricks-claude-fable-5"
#     }
#     versioned_models = [
#       "system.ai.databricks-claude-opus-5",
#       "system.ai.databricks-claude-opus-4-8",
#       "system.ai.databricks-claude-haiku-4-5",
#     ]
#   }
# }

# --- governance (applied to every endpoint) ---
# rate_limits = [
#   { key = "RATE_LIMIT_KEY_USER", renewal_period = "RATE_LIMIT_RENEWAL_PERIOD_MINUTE", requests = 100 },
# ]
# execute_principals = ["data-scientists"]

# --- telemetry (OpenTelemetry ingestion for coding agents) ---
# On by default. Needs a SQL warehouse to create the OTEL tables; it is looked up
# by name (serverless recommended — auto-starts). Set enabled = false to skip.
telemetry_enabled        = true
telemetry_warehouse_name = "Serverless Starter Warehouse" # looked up to an ID
# telemetry_warehouse_id = "5e839179e8b310b6"  # optional: skip the lookup with an explicit ID
# Developers whose otelHeadersHelper reads the UC secret get READ_SECRET here.
# telemetry_reader_groups = ["data-scientists"]
# telemetry_signals       = ["metrics", "logs", "traces"]  # trim if desired
# telemetry_schema        = "telemetry"

# --- hook telemetry (custom Claude Code reporting via Zerobus REST) ---
# Complements native OTEL with the hook-only events it can't emit: agent-usage
# (slash-command / skill / subagent + plugin inventory), reliability (StopFailure
# stalls), governance (secret/command signals, report-only), and workflow adoption.
# The generated managed-settings.json registers a hook that streams these to the
# claude_hook_events table via Zerobus REST, as the telemetry service principal.
#
# The table + the managed-settings.json hooks ship by default. The generator
# AUTO-DERIVES the workspace's Zerobus endpoint from workspace metadata at
# generation time, so you normally leave telemetry_zerobus_endpoint unset. Set it
# only to override the derived value (e.g. a private-link host).
# telemetry_hook_events_enabled = true
# telemetry_zerobus_endpoint    = "https://1234567890.zerobus.us-west-2.cloud.databricks.com"
