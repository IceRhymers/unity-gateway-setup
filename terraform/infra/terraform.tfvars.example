# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# --- auth ---
databricks_profile = "fevm-west"

# --- foundation ---
# Reference an existing catalog (default) because this environment does not
# permit catalog creation. Flip create_catalog = true where you own catalogs.
catalog_name   = "tanner_wendland_catalog"
create_catalog = false

# --- provider catalog ---
# The opinionated default in variables.tf already defines the anthropic schema
# (4 versionless aliases + version-pinned endpoints). Override model_providers
# here to add/trim endpoints or add providers. Example (partial):
#
# model_providers = {
#   anthropic = {
#     schema_comment = "Anthropic Claude"
#     aliases = {
#       "claude-opus"   = "system.ai.databricks-claude-opus-5"
#       "claude-sonnet" = "system.ai.databricks-claude-sonnet-5"
#       "claude-haiku"  = "system.ai.databricks-claude-haiku-4-5"
#       "claude-fable"  = "system.ai.databricks-claude-fable-5"
#     }
#     versioned_models = [
#       "system.ai.databricks-claude-opus-5",
#       "system.ai.databricks-claude-opus-4-8",
#       "system.ai.databricks-claude-haiku-4-5",
#     ]
#   }
# }

# --- governance (applied to every endpoint) ---
# rate_limits = [
#   { key = "RATE_LIMIT_KEY_USER", renewal_period = "RATE_LIMIT_RENEWAL_PERIOD_MINUTE", requests = 100 },
# ]
# execute_principals = ["data-scientists"]
